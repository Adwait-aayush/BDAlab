# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_INPUT_TOPIC=movie-reviews
KAFKA_OUTPUT_TOPIC=movie-sentiment-results
KAFKA_CONSUMER_GROUP=movie-sentiment-group

# Hadoop HDFS WebHDFS Configuration
WEBHDFS_URL=http://namenode:9870/webhdfs/v1
HDFS_USER=root
HDFS_RAW_DIR=/movie-sentiment/raw
HDFS_PROCESSED_DIR=/movie-sentiment/processed
HDFS_METRICS_DIR=/movie-sentiment/metrics

# Producer Configuration
PRODUCER_MODE=stream
PRODUCER_STREAM_DELAY_SECONDS=1.5
PRODUCER_BATCH_SIZE=50

# Consumer Configuration
CONSUMER_BATCH_FLUSH_SIZE=10
CONSUMER_BATCH_FLUSH_SECONDS=5.0

# Model Configuration
MODEL_PATH=artifacts/sentiment_model.joblib
TRAIN_DATA_PATH=data/sample_imdb.csv

# Streamlit Dashboard Configuration
METRICS_DATA_PATH=artifacts/live_metrics.json
STREAMLIT_REFRESH_SECONDS=3
